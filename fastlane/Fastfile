# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

before_all do |lane_name|
    app_store_lanes = [:beta, :submit]

    if app_store_lanes.include?(lane_name)
        app_store_connect_api_key(
            key_id: ENV["APPLE_KEY_ID"],
            issuer_id: ENV["APPLE_ISSUER_ID"],
            key_content: ENV["APPLE_KEY_CONTENT"],
            # is_key_content_base64: true,
            duration: 1200,
            in_house: false
        )
    end
end

platform :ios do
    lane :test do
        setup_ci if ENV['CI']
        match(
            type: "development",
            app_identifier: ["dev.bchen.Inter", "dev.bchen.Inter.widgets"]
        )
        run_tests(
            testplan: "ProjectInterTests",
            code_coverage: true,
            output_directory: "./test-output",
            result_bundle: true
        )
    end

    lane :test_ui do
        setup_ci if ENV['CI']
        match(
            type: "development",
            app_identifier: ["dev.bchen.Inter", "dev.bchen.Inter.widgets"]
        )
        run_tests(
            testplan: "ProjectInterUITests",
            code_coverage: true,
            output_directory: "./test-ui-output",
            result_bundle: true
        )
    end

    lane :beta do
        setup_ci if ENV['CI']

        match(
            type: "appstore",
            app_identifier: ["dev.bchen.Inter", "dev.bchen.Inter.widgets"]
        )

        increment_build_number(
            build_number: latest_testflight_build_number(
                version: get_version_number(
                    target: "ProjectInter"
                )
            ) + 1,
        )

        build_app(
            scheme: "ProjectInter",
            clean: true,
            xcargs: "OTHER_SWIFT_FLAGS='$(inherited)' SWIFT_ENABLE_EXPLICIT_MODULES=NO"
        )
        upload_to_testflight(skip_waiting_for_build_processing: true)
    end

    lane :set_version do |options|
        unless options[:version]
            UI.user_error! "No version number provided"
        end

        unless options[:build_number]
            UI.user_error! "No build number provided"
        end

        if options[:build_number]
            increment_build_number(
                build_number: options[:build_number]
            )
        end

        if options[:version]
            increment_version_number(
                version_number: options[:version]
            )
        end

        commit_version_bump
    end
end
