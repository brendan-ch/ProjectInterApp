// Shared.xcconfig
// Base build settings applied to every ProjectInter target. This file is wired
// in as the *project-level* base configuration, so its settings cascade to all
// targets unless a target overrides them.
//
// The development team is stored in ProjectInter.xcodeproj itself (Xcode
// rewrites it there regardless, whenever Signing & Capabilities is touched),
// so it is intentionally NOT set in this file.

CODE_SIGN_STYLE = Automatic
